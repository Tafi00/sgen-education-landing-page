{
  "name": "sgen-education-landing-page",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"npm:dev:api\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build && npm run build:api",
    "build:api": "esbuild server/src/index.ts server/src/scripts/seed.ts server/src/scripts/create-admin.ts server/src/db/migrate.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=dist-server",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "seed": "tsx server/src/scripts/seed.ts",
    "create-admin": "tsx server/src/scripts/create-admin.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit --pretty false",
    "test": "vitest run",
    "smoke": "tsx server/src/scripts/smoke.ts",
    "seed:force": "tsx server/src/scripts/seed.ts --force",
    "migrate": "tsx server/src/db/migrate.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.62.0",
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "fontkit": "^2.0.4",
    "helmet": "^8.0.0",
    "lucide-react": "^1.31.0",
    "lunar-javascript": "^1.7.7",
    "multer": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/fontkit": "^2.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^3.0.0"
  }
}
