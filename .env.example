# Cấu hình môi trường cho SGEN Education.
# Sao chép file này thành `.env` rồi điền giá trị thật. `npm run dev` tự nạp `.env`.

# Cổng API/CMS (mặc định 4000). Vite dev proxy /api và /uploads sang cổng này.
PORT=4000

# Chuỗi kết nối PostgreSQL (bắt buộc khi chạy thật). Schema tự được áp khi khởi động.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Số kết nối tối đa trong pool (mặc định 10).
DATABASE_POOL_SIZE=10

# Đặt false nếu chạy production qua HTTP chưa có chứng chỉ (mặc định: true ở production).
COOKIE_SECURE=true

# Origin công khai, dùng cho link chi tiết trong thông báo và canonical/OG.
PUBLIC_ORIGIN=http://127.0.0.1:5173

# Thư mục lưu ảnh tải lên; website phục vụ công khai tại /uploads.
UPLOAD_DIR=uploads

# Khoá phiên đăng nhập và khoá mã hoá secret trong CMS.
# Bỏ trống thì hệ thống sinh khoá ngẫu nhiên và lưu vào `.data/` (nhớ sao lưu file này).
SESSION_SECRET=
SETTINGS_ENC_KEY=

# Thư mục chứa khoá sinh tự động (mặc định .data)
DATA_DIR=.data

# Dùng một lần khi tạo admin đầu tiên bằng `npm run create-admin`.
ADMIN_EMAIL=admin@sgen.vn
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị SGEN
